# Agent backend: deepseek (default), claude, codex, or agy.
# deepseek → DeepSeek Harness SDK, needs DEEPSEEK_API_KEY below.
# claude   → headless `claude -p` (Claude Code CLI), brings its own credentials.
# codex    → headless `codex exec` (Codex CLI), brings its own credentials.
# agy      → headless `agy` (Antigravity CLI), brings its own credentials.
HARNESS_PROVIDER=deepseek
HARNESS_CLAUDE_MODEL=sonnet
# HARNESS_CODEX_MODEL=gpt-5.5
# HARNESS_AGY_MODEL=gemini-3.8-flash
# Code review axis (defects in the changed code + inline comments). 0 to switch off.
HARNESS_CODE_REVIEW=1

DEEPSEEK_API_KEY=sk-your-key-here
DSH_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DSH_SESSION_ROOT=sessions
